{
  "name": "n8n-nodes-grades",
  "version": "1.0.1",
  "description": "Grades.com for n8n: reviews, replies, the review agent, review requests and instant triggers.",
  "keywords": [
    "n8n-community-node-package",
    "grades",
    "reviews",
    "reputation",
    "review requests"
  ],
  "license": "MIT",
  "homepage": "https://www.grades.com/integrations/n8n",
  "author": {
    "name": "Melen, LLC (Grades.com)",
    "email": "support@grades.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smart-sites/grades-n8n-nodes.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "files": [
    "dist",
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GradesApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Grades/Grades.node.js",
      "dist/nodes/GradesTrigger/GradesTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "n8n-workflow": "2.16.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "bugs": {
    "url": "https://github.com/smart-sites/grades-n8n-nodes/issues",
    "email": "support@grades.com"
  }
}
